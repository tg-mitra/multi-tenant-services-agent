# Copy this file to .env and fill in your values. Never commit .env.

# --- LLM (Step 1) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (leave empty for OpenAI itself)
OPENAI_BASE_URL=
# Leave empty to use the model default (some models reject temperature=0)
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=30

# --- Step 2 ---
# Where conversation JSON files are saved (git-ignored)
STATE_DIR=./state

# --- Dev helper: GET /dev/members lists tenants and member ids (no PHI). Keep false anywhere shared. ---
DEV_ENDPOINTS_ENABLED=false
# Folder that contains mock_services/ and eval/ (used only by the dev helper for now)
PACK_DIR=.

# --- Step 5: PHI filter ---
# true = scrub tool results, redact what the model/disk sees, block sensitive replies
PHI_FILTER_ENABLED=true
# verify_caller calls allowed per rep message
MAX_VERIFY_ATTEMPTS=3

# --- Step 4: member / benefits / claims API (the mock, or the client's real service) ---
MEMBER_API_BASE=http://localhost:8090
# Bearer token issued per tenant (see the pack's data README). Never commit real values.
TENANT_TOKEN_PLAN_A=
TENANT_TOKEN_PLAN_B=
HTTP_TIMEOUT_SECONDS=10
# On a 429 we wait Retry-After only if it is at most this many seconds, then retry (bounded)
RETRY_AFTER_MAX_SECONDS=2
MAX_API_RETRIES=2
# Max model/tool hops per rep message (LangGraph recursion limit)
MAX_GRAPH_STEPS=12
AS_OF_DATE=2026-11-15

# --- Step 3 ---
# Number of most recent exchanges (rep message + reply) sent to the LLM on follow-ups. 0 = none.
HISTORY_TURNS=8
