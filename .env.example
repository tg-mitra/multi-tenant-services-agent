# Copy this file to .env and fill in your values. Never commit .env.

# --- LLM (Step 1) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (leave empty for OpenAI itself)
OPENAI_BASE_URL=
# Leave empty to use the model default (some models reject temperature=0)
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=30

# --- Step 2 ---
# Where conversation JSON files are saved (git-ignored)
STATE_DIR=./state

# --- Step 3 ---
# Number of most recent exchanges (rep message + reply) sent to the LLM on follow-ups. 0 = none.
HISTORY_TURNS=8
