        {
          "name": "Step 9: budgets and trace",
          "item": [
            {
              "name": "Conversation: see the budget summary",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{host}}/conversations",
                  "host": [
                    "{{host}}"
                  ],
                  "path": [
                    "conversations"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tenant\": \"{{tenant}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"message\": \"How many of this member's 2026 claims were denied?\",\n  \"conversation_id\": \"0\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Every response includes a 'budget' object: this message's model/tool calls and cost, the conversation's running totals, and which limit (if any) stopped it. Run the trace request below with the returned conversation_id."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Save the conversation_id from the response so the follow-up request can reuse it",
                      "try { const j = pm.response.json(); if (j.conversation_id) { pm.collectionVariables.set('conversation_id', j.conversation_id); } } catch (e) {}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "GET the trace for that conversation",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{host}}/conversations/{{conversation_id}}/trace?tenant={{tenant}}&member_id={{member_id}}",
                  "host": [
                    "{{host}}"
                  ],
                  "path": [
                    "conversations",
                    "{{conversation_id}}",
                    "trace"
                  ],
                  "query": [
                    {
                      "key": "tenant",
                      "value": "{{tenant}}"
                    },
                    {
                      "key": "member_id",
                      "value": "{{member_id}}"
                    },
                    {
                      "key": "turn",
                      "value": "",
                      "disabled": true,
                      "description": "optional: limit to one turn number"
                    }
                  ]
                },
                "description": "Run 'Conversation: see the budget summary' first. Returns the redacted step-by-step trace: model calls (tokens, cost), tool calls, gateway decisions, confirmations and guard events. Never contains message text, prompts, replies or raw member ids - tenant and member_id must match the conversation or this returns 404."
              },
              "response": []
            }
          ],
          "description": "Per-conversation budgets (steps, cost, time) and the full step-by-step trace."
        },
