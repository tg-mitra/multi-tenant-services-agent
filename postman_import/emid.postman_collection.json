{
  "info": {
    "_postman_id": "e612923c-b221-4b56-8fa4-a51d79c629a1",
    "name": "Emid - Member Services Agent",
    "description": "Our API (FastAPI, port 8000) - one example per build step - and the mock service (port 8090). Fill token_plan_a, token_plan_b and directory_key in the collection Variables tab; do not commit this file with secret values filled in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Our API (port 8000)",
      "item": [
        {
          "name": "Step 0-3: health, chat, conversation history",
          "item": [
            {
              "name": "Health",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{host}}/health",
                  "host": [
                    "{{host}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "DEV: list tenants and member ids",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{host}}/dev/members?tenant=",
                  "host": [
                    "{{host}}"
                  ],
                  "path": [
                    "dev",
                    "members"
                  ],
                  "query": [
                    {
                      "key": "tenant",
                      "value": "",
                      "disabled": true,
                      "description": "plan_a or plan_b (optional)"
                    }
                  ]
                },
                "description": "Development helper. Lists tenants, their products and member ids (no names or other PHI), coverage status and the eval cases that use each member. Needs DEV_ENDPOINTS_ENABLED=true in .env. Use a member_id from here in the Conversation requests."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Convenience: remember the first member of the first tenant as tenant/member_id",
                      "try { const t = pm.response.json().tenants[0]; pm.collectionVariables.set('tenant', t.tenant); pm.collectionVariables.set('member_id', t.members[0].member_id); } catch (e) {}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Conversation: start new",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{host}}/conversations",
                  "host": [
                    "{{host}}"
                  ],
                  "path": [
                    "conversations"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tenant\": \"{{tenant}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"message\": \"What is the status of claim {{claim_id}}?\",\n  \"conversation_id\": \"0\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "conversation_id 0 / null / blank starts a new conversation. The returned id is saved to the collection variable conversation_id. Demonstrates Steps 1-4 (chat, storage, history, claim lookup through the gateway)."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Save the conversation_id from the response so the follow-up request can reuse it",
                      "try { const j = pm.response.json(); if (j.conversation_id) { pm.collectionVariables.set('conversation_id', j.conversation_id); } } catch (e) {}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Conversation: follow-up (same conversation)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{host}}/conversations",
                  "host": [
                    "{{host}}"
                  ],
                  "path": [
                    "conversations"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tenant\": \"{{tenant}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"message\": \"And what was the billed amount?\",\n  \"conversation_id\": \"{{conversation_id}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Run 'Conversation: start new' first. Uses the saved conversation_id; the last HISTORY_TURNS exchanges are sent to the model (Step 3)."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Save the conversation_id from the response so the follow-up request can reuse it",
                      "try { const j = pm.response.json(); if (j.conversation_id) { pm.collectionVariables.set('conversation_id', j.conversation_id); } } catch (e) {}"
                    ]
                  }
                }
              ]
            }
          ],
          "description": "Steps 0-3: project setup, the basic LangGraph chat endpoint, JSON conversation storage, and sending history on follow-ups."
        },
